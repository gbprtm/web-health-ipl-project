# Database PostgreSQL (Neon)
# URL koneksi dengan connection pooling (untuk runtime aplikasi)
DATABASE_URL="postgresql://user:password@ep-pool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# URL koneksi direct / tanpa pooling (untuk migrasi Drizzle Kit)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Kunci rahasia sesi jose JWT (minimal 32 karakter)
SESSION_SECRET="ganti_dengan_minimal_32_karakter_acak_dan_rahasia_untuk_sesi"

# URL aplikasi untuk redirect autentikasi
APP_URL="http://localhost:3000"
